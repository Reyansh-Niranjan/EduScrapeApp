# NovaSlate — Environment Configuration Template
# Copy this file to `.env.local` for local development.

# Vite Client Variables (required for frontend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_SITE_URL=http://localhost:5173

# Backend & NCERT Scraper Pipeline (used by Python scripts and sync pipeline)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Internet Archive (IAS3) Storage (Free, zero-egress PDF hosting)
IA_ACCESS_KEY=your-ia-access-key
IA_SECRET_KEY=your-ia-secret-key
IA_BUCKET=novaslate-ncert-library
